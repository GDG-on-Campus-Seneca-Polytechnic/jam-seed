{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gdg-jam-seed",
  "main": "src/server.js",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "durable_objects": {
    "bindings": [{ "name": "JAMS", "class_name": "Jam" }]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["Jam"]
    }
  ],
  "vars": {
    "GEMINI_MODEL": "gemini-3-flash-preview"
  },
  "observability": { "enabled": true }
}
